#!/usr/bin/env bash
# Security gate before anything leaves this machine. Installed with: make install-hooks
# git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  python3 "$ROOT/scripts/security/scan.py" push "$remote_sha" "$local_sha" || status=1
done
if [ "$status" -ne 0 ]; then
  echo "pre-push blocked by the security gate. Fix the FAIL lines, or bypass knowingly with --no-verify." >&2
fi
exit "$status"
